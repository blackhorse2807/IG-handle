# ---------- Server ----------
PORT=3000
# Public HTTPS URL of the deployed server (Vercel), no trailing slash
PUBLIC_URL=https://your-project.vercel.app

# ---------- Admin login ----------
# Password for the admin page, and a long random string used to sign login sessions (JWT)
ADMIN_PASSWORD=
JWT_SECRET=

# ---------- Storage ----------
# MongoDB connection string (MongoDB Atlas free M0 cluster). Required on Vercel.
# Leave empty locally to use the JSON file data/db.json instead.
MONGODB_URI=
MONGODB_DB=ig_handle_capture

# ---------- Instagram (Meta app -> Instagram -> API setup with Instagram login) ----------
# Your Instagram professional account handle, without @
IG_USERNAME=your_instagram_handle
# Instagram user access token (starts with IG...)
IG_TOKEN=
# App secret: Meta signs each webhook with it and the server rejects requests that don't match.
# Facebook-login setup: App settings -> Basic -> App secret. Leave empty only for local testing.
IG_APP_SECRET=
# Any string you choose; paste the same value in the Meta webhook config
IG_VERIFY_TOKEN=pick-any-random-string

# ---------- Behaviour ----------
GRAPH_VERSION=v25.0
# Invite links stop working this many hours after they are created (default 24)
INVITE_TTL_HOURS=24
# Set to 1 to skip real Instagram API calls (offline simulation)
MOCK_MODE=0
